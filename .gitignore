# ============================================================
# JavaScript / Yarn 의존성
# ============================================================
node_modules/
.pnp
.pnp.js
.yarn/build-state.yml
.yarn/install-state.gz
.yarn/unplugged/

# package.json과 yarn.lock은 Git 추적을 유지합니다.

# ============================================================
# 프론트엔드 및 백엔드 빌드 결과물
# ============================================================
build/
dist/
dist-ssr/
out/
bin/
storybook-static/

# 소스 패키지 이름으로 사용된 build, out, bin 디렉터리는 제외하지 않습니다.
!**/src/main/**/build/
!**/src/test/**/build/
!**/src/main/**/out/
!**/src/test/**/out/
!**/src/main/**/bin/
!**/src/test/**/bin/

# ============================================================
# Java / Gradle
# ============================================================
.gradle/
*.class
*.jar
*.war
*.ear
*.hprof
hs_err_pid*
replay_pid*

# 프로젝트 실행에 필요한 Gradle Wrapper JAR은 제외하지 않습니다.
!**/gradle/wrapper/gradle-wrapper.jar

# ============================================================
# 테스트 및 코드 커버리지
# ============================================================
coverage/
.nyc_output/
playwright-report/
test-results/
cypress/screenshots/
cypress/videos/

# ============================================================
# 도구 및 번들러 캐시
# ============================================================
.cache/
.parcel-cache/
.sass-cache/
.swc/
.turbo/
.vite/
.eslintcache
.stylelintcache
.prettier-cache
*.tsbuildinfo

