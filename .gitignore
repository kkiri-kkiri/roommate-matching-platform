# ============================================================
# JavaScript / Yarn dependencies
# ============================================================
node_modules/
.pnp
.pnp.js
.yarn/build-state.yml
.yarn/install-state.gz
.yarn/unplugged/

# Keep package.json and yarn.lock tracked.

# ============================================================
# Frontend and backend build outputs
# ============================================================
build/
dist/
dist-ssr/
out/
bin/
storybook-static/

# A source package can legitimately be named "build", "out", or "bin".
!**/src/main/**/build/
!**/src/test/**/build/
!**/src/main/**/out/
!**/src/test/**/out/
!**/src/main/**/bin/
!**/src/test/**/bin/

# ============================================================
# Java / Gradle
# ============================================================
.gradle/
*.class
*.jar
*.war
*.ear
*.hprof
hs_err_pid*
replay_pid*

# The Gradle Wrapper JAR is required to run the project.
!**/gradle/wrapper/gradle-wrapper.jar

# ============================================================
# Tests and coverage
# ============================================================
coverage/
.nyc_output/
playwright-report/
test-results/
cypress/screenshots/
cypress/videos/

