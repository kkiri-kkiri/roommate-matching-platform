.env
.env.*
!.env.example
!.env.*.example
*.local

application-local.properties
application-local.yml
application-local.yaml
application-secrets.properties
application-secrets.yml
application-secrets.yaml

secrets/
credentials.json
service-account*.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
!*.example.pem
!*.example.key

