nbbuild/
nbdist/
.nb-gradle/

# ============================================================
# 운영체제 파일
# ============================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

