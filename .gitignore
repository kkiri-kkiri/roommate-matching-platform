logs/
*.log
*.pid
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
backend/uploads/
frontend/uploads/
docker-data/

# ============================================================
# 로컬 설정 및 비밀 정보
